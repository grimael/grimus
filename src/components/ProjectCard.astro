---
import type { Project } from '../data/projects';

type Props = {
  project: Project;
};

const { project } = Astro.props;
const stackJson = JSON.stringify(project.stack);
const repoAria = `Dépôt GitHub : ${project.title}`;
const openAria = `Voir les détails du projet ${project.title}`;
---

<article
  class="project-card"
  data-category={project.category}
  data-title={project.title}
  data-summary={project.summary}
  data-impact={project.impact}
  data-image={project.image}
  data-stack={stackJson}
  data-live-url={project.liveUrl ?? ''}
  data-repo-url={project.repoUrl ?? ''}
  data-repo-aria={repoAria}
  data-private={project.private ? '1' : ''}
>
  <button type="button" class="project-media" data-open-project aria-label={openAria}>
    <img src={project.image} alt="" loading="eager" decoding="async" width="900" height="560" />
    <span class="media-tag">{project.category}</span>
  </button>
  <div class="project-body">
    <h3>{project.title}</h3>
    <div class="project-meta">
      <span class="status-dot">Étude de cas</span>
      <span>{project.stack[0]}</span>
    </div>
    <button type="button" class="btn btn-ghost btn-compact details-btn" data-open-project>Détails</button>
  </div>
</article>
