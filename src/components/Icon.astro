---
import { icons } from 'lucide';
type Props = { name: keyof typeof icons; size?: number; class?: string };
const { name, size = 20, class: className } = Astro.props;
const nodes = icons[name];
if (!nodes) throw new Error(`Unknown Lucide icon: ${String(name)}`);
---
<svg class:list={['icon', className]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nodes.map(([Tag, attrs]) => <Tag {...attrs} />)}
</svg>
