---
import Icon from '../Icon.astro';
import ProjectCard from '../ProjectCard.astro';
import Journey from '../Journey.astro';
import ministryLogo from '../../../assets/organizations/METFPA.png';
import observatoireLogo from '../../../assets/organizations/observatoire.png';
import { projects } from '../../data/projects';
import { skillLogos } from '../../data/profile';
import { expertise } from '../../data/content';
import { withBase } from '../../lib/paths';
import { ui, localizedPath, type Lang } from '../../lib/i18n';
type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];
const featured = ['opendataviz-observatoire-afrique', 'rh-ia-pro', 'prediction-nps-artefact'].map(slug => projects.find(p => p.slug === slug)!);
const names = ['Python', 'R', 'SQL', 'PostgreSQL', 'Docker', 'Git', 'GitHub', 'Power BI', 'Tableau', 'R Shiny'];
const technologies = names.map(name => skillLogos.find(s => s.name === name)!);
const valueIcons = ['ScanSearch', 'BookOpen', 'ChartNoAxesCombined', 'Sprout'] as const;
const organizations = [
  { src: withBase('/assets/organizations/ensea.png'), alt: 'ENSEA d’Abidjan', width: 175, height: 78 },
  { src: withBase('/assets/organizations/sanlamallianz.svg'), alt: 'SanlamAllianz Participations', width: 190, height: 40 },
  { src: observatoireLogo.src, alt: 'Observatoire du Service Public', width: 447, height: 447 },
  { src: ministryLogo.src, alt: 'Ministère de l’Enseignement Technique, de la Formation Professionnelle et de l’Apprentissage', width: 554, height: 554 }
];
---
<section class="hero-section">
  <div class="container hero-layout">
    <div class="hero-copy">
      <p class="hero-eyebrow entrance">{t.eyebrow}</p>
      <h1 class="entrance"><span>{t.heroLine1}</span><span>{t.heroLine2}</span><span class="accent-text">{t.heroAccent}<b class="warm-dot">.</b></span></h1>
      <p class="hero-description entrance">{t.heroDescription}</p>
      <div class="cta-row entrance"><a class="btn btn-primary" href={localizedPath('projects', lang)}>{t.explore}<Icon name="ArrowRight" /></a><a class="btn btn-secondary" href={localizedPath('contact', lang)}><Icon name="Mail" />{t.contact}</a></div>
    </div>
    <div class="hero-visual">
      <figure class="hero-portrait entrance"><img src={withBase('/assets/Images/optimized/grima-editorial.webp')} alt="Portrait de Michaël S. GRIMA en noir et blanc" width="1024" height="1024" fetchpriority="high" decoding="async" /></figure>
    </div>
  </div>
</section>
<section class="technology-section" aria-label={t.technology}>
  <div class="container technology-strip">
    <div class="technology-label"><p>{t.technology}</p><button class="icon-button marquee-toggle" type="button" data-marquee-toggle aria-pressed="false" aria-controls="technology-window" aria-label="Mettre en pause le défilement des technologies" title="Mettre en pause le défilement des technologies" data-pause-label="Mettre en pause le défilement des technologies" data-play-label="Reprendre le défilement des technologies"><Icon name="Pause" size={14} /><Icon name="Play" size={14} /></button></div>
    <div class="technology-window" id="technology-window" tabindex="0" role="region" aria-label={t.technology}>
      <div class="technology-track">
        {[0, 1].map(copy => <div class="technology-set" aria-hidden={copy === 1 ? 'true' : undefined}>{technologies.map(tech => <div class="technology-logo" title={tech.name}><img src={tech.icon} alt="" width="32" height="32" loading="eager" decoding="async" /><span>{tech.name}</span></div>)}</div>)}
      </div>
    </div>
  </div>
</section>
<section class="organizations-section">
  <div class="container organizations-inner">
    <div class="organizations-label"><p class="eyebrow">{t.organizations}</p><button class="icon-button marquee-toggle" type="button" data-marquee-toggle aria-pressed="false" aria-controls="organizations-window" aria-label="Mettre en pause le défilement des structures" title="Mettre en pause le défilement des structures" data-pause-label="Mettre en pause le défilement des structures" data-play-label="Reprendre le défilement des structures"><Icon name="Pause" size={14} /><Icon name="Play" size={14} /></button></div>
    <div class="organizations-window" id="organizations-window" tabindex="0" role="region" aria-label={t.organizations}>
      <div class="organizations-track">
        {[0, 1].map(copy => <div class="organizations-set" aria-hidden={copy === 1 ? 'true' : undefined}>{organizations.map(organization => <div class="organization-mark"><img class="organization-logo" src={organization.src} alt={copy === 0 ? organization.alt : ''} width={organization.width} height={organization.height} loading="eager" decoding="async" /></div>)}</div>)}
      </div>
    </div>
  </div>
</section>
<section class="expertise-section section-space" id="expertise">
  <div class="container">
    <div class="section-heading section-heading-split" data-reveal><div><p class="eyebrow">{t.expertiseEyebrow}</p><h2>{t.expertiseTitle}</h2></div><div class="section-intro"><p>{t.expertiseDescription}</p><a class="text-link" href={localizedPath('expertise', lang)}>{t.more}<Icon name="ArrowRight" size={16} /></a></div></div>
    <div class="expertise-grid">{expertise.map(item => <a class="expertise-card" href={`${localizedPath('projects', lang)}?category=${encodeURIComponent(item.category)}`} data-reveal><span class="expertise-icon"><Icon name={item.icon} size={25} /></span><h3>{item[lang][0]}</h3><p>{item[lang][1]}</p><Icon name="ArrowUpRight" size={16} class="expertise-arrow" /></a>)}</div>
  </div>
</section>
<section class="featured-section dark-band section-space">
  <div class="container">
    <div class="section-heading section-heading-split" data-reveal><div><p class="eyebrow">{t.featuredEyebrow}</p><h2>{t.featuredTitle}</h2></div><div class="section-intro"><p>{t.featuredDescription}</p><a class="btn btn-outline-light btn-small" href={localizedPath('projects', lang)}>{t.allProjects}<Icon name="ArrowRight" size={16} /></a></div></div>
    <div class="featured-grid">{featured.map(project => <ProjectCard project={project} lang={lang} featured />)}</div>
  </div>
</section>
<section class="journey-section section-space">
  <div class="container journey-layout"><div data-reveal><p class="eyebrow">{t.journeyEyebrow}</p><h2>{t.journeyTitle}</h2><a class="text-link" href={`${localizedPath('about', lang)}#journey`}>{t.journeyLink}<Icon name="ArrowRight" size={16} /></a></div><Journey lang={lang} compact /><div class="values-block" data-reveal><h3>{t.valuesTitle}</h3><ul>{t.values.map((value, i) => <li><Icon name={valueIcons[i]} size={17} />{value}</li>)}</ul></div></div>
</section>
