---
import Icon from '../Icon.astro';
import PageIntro from '../PageIntro.astro';
import Journey from '../Journey.astro';
import ProjectCard from '../ProjectCard.astro';
import { ui, localizedPath, type Lang } from '../../lib/i18n';
import { projects } from '../../data/projects';
type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];
---
<PageIntro eyebrow={t.aboutEyebrow} title={t.aboutSubtitle} lead={t.aboutLead} class="about-intro" />
<section class="about-body section-space">
  <div class="container biography-layout"><div class="section-heading" data-reveal><p class="eyebrow">STATISTIQUE & APPLICATIONS</p><h2>Une méthode.<br />Des applications.</h2><a class="text-link" href={localizedPath('expertise', lang)}>{t.nav[2]}<Icon name="ArrowRight" size={16} /></a></div><div class="biography">{t.aboutParagraphs.map(p => <p>{p}</p>)}</div></div>
</section>
<section class="approach-section section-space"><div class="container"><div class="section-heading" data-reveal><p class="eyebrow">{t.approachEyebrow}</p><h2>{t.approachTitle}</h2></div><div class="approach-grid">{t.approachSteps.map(([title, text], i) => <article data-reveal><span class="step-number">0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section class="section-space" id="journey"><div class="container full-journey"><div class="section-heading" data-reveal><p class="eyebrow">{t.journeyEyebrow}</p><h2>{t.journeyTitle}</h2></div><Journey lang={lang} /></div></section>
<section class="section-space dark-band"><div class="container"><div class="section-heading"><p class="eyebrow">{t.featuredEyebrow}</p><h2>{t.featuredTitle}</h2></div><div class="featured-grid">{[projects[0], projects[10], projects[1]].map(project => <ProjectCard project={project} lang={lang} />)}</div></div></section>
