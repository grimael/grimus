---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortraitFrame from '../components/PortraitFrame.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { projects } from '../data/projects';

const categories = ['Tous', ...Array.from(new Set(projects.map((project) => project.category)))];
const heading = `${projects.length} livrables sélectionnés`;
---

<BaseLayout
  title="Projets"
  description="Projets data, tableaux de bord, économétrie, cartographie et visualisation avec liens vers livrables et dépôts GitHub."
>
  <section class="page-hero page-hero-media">
    <div>
      <p class="eyebrow">Portfolio de projets</p>
      <h1>Des projets data présentés comme des produits finis.</h1>
    </div>
    <PortraitFrame photo="costume-serre" code="Projets.03" caption="Livrables data" />
  </section>

  <section class="filter-shell" aria-label="Categories de projets">
    {categories.map((category) => (
      <button class={category === 'Tous' ? 'is-active' : ''} type="button" data-filter={category}>
        {category}
      </button>
    ))}
  </section>

  <section id="all" class="band-alt">
    <SectionHeading eyebrow="Tous les projets" title={heading} />
    <div class="projects-list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="empty-state" data-empty-state hidden>Aucun projet dans cette catégorie pour le moment.</p>
  </section>
</BaseLayout>
