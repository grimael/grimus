---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortraitFrame from '../components/PortraitFrame.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile, skillLogos, expertisePillars } from '../data/profile';

const logosByName = new Map(skillLogos.map((logo) => [logo.name, logo]));
const pillars = expertisePillars.map((pillar, index) => ({
  ...pillar,
  number: String(index + 1).padStart(2, '0'),
  tools: pillar.tools.map((name) => {
    const logo = logosByName.get(name);
    if (!logo) throw new Error(`Unknown tool "${name}": add it to skillLogos in src/data/profile.ts`);
    return logo;
  })
}));
---

<BaseLayout
  title="À propos"
  description="À propos : statisticien et data analyst, compétences, approche, outils et philosophie de travail."
>
  <section class="page-hero page-hero-media about-hero">
    <div>
      <p class="eyebrow">À propos</p>
      <h1>Un profil data qui relie science statistique, analyse métier et développement web.</h1>
      <p>{profile.headline}</p>
    </div>
    <PortraitFrame photo="ensea" code="Profil.02" caption="À propos" />
  </section>

  <section class="band-alt">
    <div class="about-copy">
      <SectionHeading eyebrow="Approche" title="Comprendre avant de visualiser. Prouver avant de convaincre." />
      <p>
        Diplômé de l'ENSEA d'Abidjan, je combine les méthodes quantitatives, l'économétrie, la BI et l'ingénierie des données
        pour concevoir des solutions data complètes : collecte, pipelines ETL, entrepôt de données, tableaux de bord et analyses.
      </p>
      <p>
        Mes expériences couvrent l'assurance, le service public, la formation professionnelle et la recherche appliquée,
        avec un fil conducteur : rendre la donnée fiable, lisible et utile à la décision.
      </p>
    </div>
  </section>

  <section id="expertise">
    <SectionHeading eyebrow="Expertise" title="Sept piliers, de la donnée brute au produit en ligne." />
    <div class="pillar-grid">
      {pillars.map((pillar) => (
        <article class:list={['pillar-card', { 'is-wide': pillar.wide }]}>
          <span class="pillar-number" aria-hidden="true">{pillar.number}</span>
          <header class="pillar-head">
            <h3>{pillar.title}</h3>
            <p>{pillar.lead}</p>
          </header>
          <ul class="pillar-skills">
            {pillar.skills.map((skill) => <li>{skill}</li>)}
          </ul>
          <div class="pillar-tools">
            <p class="pillar-tools-label">Outils</p>
            <ul class="tool-chips">
              {pillar.tools.map((tool) => (
                <li
                  class:list={['tool-chip', { 'logo-missing': !tool.icon }]}
                  data-logo={tool.initials ?? tool.name.slice(0, 2).toUpperCase()}
                >
                  {tool.icon && (
                    <img src={tool.icon} alt="" loading="lazy" decoding="async" width="22" height="22" />
                  )}
                  <span>{tool.name}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="band-alt">
    <SectionHeading eyebrow="Experience" title="Des missions data concrètes, connectées aux enjeux métiers." />
    <div class="timeline">

      <div class="timeline-item is-current">
        <div class="timeline-marker">
          <span class="timeline-dot"></span>
          <span class="timeline-line"></span>
        </div>
        <div class="timeline-content">
          <div class="timeline-header">
            <span class="timeline-date">Janv. 2026 — Présent</span>
            <span class="timeline-badge current">En poste</span>
          </div>
          <h3 class="timeline-role">Support Data & Business Intelligence</h3>
          <p class="timeline-org">SanlamAllianz Participations</p>
          <p class="timeline-desc">
            Analyse de données financières clients, conception de tableaux de bord Power BI
            et mise en place de pipelines ETL via Apache Hop pour automatiser le reporting mensuel.
          </p>
          <div class="timeline-stack">
            <span>Power BI</span>
            <span>Apache Hop</span>
            <span>ETL</span>
            <span>SQL</span>
            <span>Finance</span>
          </div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="timeline-dot"></span>
          <span class="timeline-line"></span>
        </div>
        <div class="timeline-content">
          <div class="timeline-header">
            <span class="timeline-date">Oct. 2025 — Janv. 2026</span>
          </div>
          <h3 class="timeline-role">Statisticien — Data Analyst</h3>
          <p class="timeline-org">Observatoire du Service Public</p>
          <p class="timeline-desc">
            Analyse multi-sources et production de rapports analytiques avec recommandations
            stratégiques. Suivi et modélisation d'indicateurs de performance du service public.
          </p>
          <div class="timeline-stack">
            <span>Python</span>
            <span>R</span>
            <span>KPI</span>
            <span>Reporting</span>
            <span>Service public</span>
          </div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="timeline-dot"></span>
        </div>
        <div class="timeline-content">
          <div class="timeline-header">
            <span class="timeline-date">Mai 2025 — Sept. 2025</span>
          </div>
          <h3 class="timeline-role">Statisticien — Data Analyst</h3>
          <p class="timeline-org">Ministere de l'Enseignement Technique</p>
          <p class="timeline-desc">
            Architecture ETL et entrepôt de données national, modélisation de KPIs nationaux
            et mise en place d'un reporting automatisé sous Apache Superset.
          </p>
          <div class="timeline-stack">
            <span>Apache Superset</span>
            <span>Entrepôt de données</span>
            <span>ETL</span>
            <span>SQL</span>
            <span>Education</span>
          </div>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
