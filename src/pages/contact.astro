---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortraitFrame from '../components/PortraitFrame.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';

const subject = encodeURIComponent('Projet data depuis votre portfolio');
const body = encodeURIComponent('Bonjour,\n\nJe souhaite discuter avec vous d’un projet data.\n\nContexte :\nObjectif :\nDélai :\n');

const mailto = `mailto:${profile.email}?subject=${subject}&body=${body}`;

const contacts = [
  {
    label: 'Email',
    sublabel: profile.email,
    href: mailto,
    icon: withBase('/assets/logos/email.svg'),
    brandClass: 'brand-email',
    external: false,
  },
  {
    label: 'LinkedIn',
    sublabel: 'Voir mon profil',
    href: profile.linkedin,
    icon: withBase('/assets/logos/linkedin.svg'),
    brandClass: 'brand-linkedin',
    external: true,
  },
  {
    label: 'GitHub',
    sublabel: 'grimael',
    href: profile.github,
    icon: withBase('/assets/logos/github.svg'),
    brandClass: 'brand-github',
    external: true,
  },
];
---

<BaseLayout
  title="Contact"
  description="Contact pour un projet data, tableau de bord, visualisation, statistique ou analyse économétrique."
>
  <section class="page-hero page-hero-media contact-hero">
    <div>
      <p class="eyebrow">Contact</p>
      <h1>Parlons du problème, du livrable et de l'effet que vous voulez produire.</h1>
    </div>
    <PortraitFrame photo="sourire" code="Contact.04" caption="Discussion projet" />
  </section>

  <section class="faq-grid band-alt">
    <article>
      <h3>Quels projets ?</h3>
      <p>Analyse statistique, tableaux de bord, cartographie, data storytelling, rapports et supports de présentation.</p>
    </article>
    <article>
      <h3>Quels livrables ?</h3>
      <p>Tableau de bord, rapport analytique, notebook, présentation, visualisation ou aide à la décision.</p>
    </article>
  </section>

  <section>
    <p class="eyebrow">Canaux disponibles</p>
    <h2>Choisissez votre moyen de contact préféré.</h2>
    <div class="social-grid">
      {contacts.map((c) => (
        <a
          class:list={['social-card', c.brandClass]}
          href={c.href}
          target={c.external ? '_blank' : undefined}
          rel={c.external ? 'noopener noreferrer' : undefined}
          aria-label={c.label}
          data-logo={c.label.slice(0, 2).toUpperCase()}
        >
          <img src={c.icon} alt={c.label} width="48" height="48" loading="lazy" decoding="async" fetchpriority="low" />
          <strong>{c.label}</strong>
          <small>{c.sublabel}</small>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
