---
import '../styles/fonts.css';
import '../styles/global.css';
import { withBase } from '../lib/paths';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://grimael.github.io');
// Vite's dev server injects CSS via inline <style> tags and its client/toolbar write
// HTML strings, so 'unsafe-inline', data: images and Trusted Types are relaxed only
// while running `astro dev`, never in the deployed site. No asset is loaded from a
// third party: fonts, logos and images are all served from this origin.
const isDev = import.meta.env.DEV;
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "frame-src 'none'",
  `img-src 'self'${isDev ? ' data:' : ''}`,
  `style-src 'self'${isDev ? " 'unsafe-inline'" : ''}`,
  "font-src 'self'",
  "script-src 'self'",
  "connect-src 'self'",
  "media-src 'none'",
  "worker-src 'none'",
  "manifest-src 'none'",
  "form-action 'none'",
  ...(isDev ? [] : ["require-trusted-types-for 'script'", "trusted-types 'none'"]),
  'upgrade-insecure-requests'
].join('; ');
const nav = [
  { href: withBase('/'), label: 'Accueil' },
  { href: withBase('/about/'), label: 'À propos' },
  { href: withBase('/projects/'), label: 'Projets' },
  { href: withBase('/contact/'), label: 'Contact' }
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index,follow" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    {/* is:inline keeps these public scripts as plain external tags (Astro 7 would otherwise process and drop them). */}
    <script is:inline src={withBase('/pref-init.js')}></script>
  </head>
  <body>
    <canvas id="data-bg" aria-hidden="true"></canvas>
    <div class="page-grid" aria-hidden="true"></div>
    <div class="page-corners" aria-hidden="true">
      <span class="is-tl"></span><span class="is-tr"></span><span class="is-bl"></span><span class="is-br"></span>
    </div>
    <a class="skip-link" href="#content">Aller au contenu</a>
    <header class="site-header">
      <nav class="nav-shell" aria-label="Navigation principale">
        <a class="signature" href={withBase('/')} aria-label="Michaël S. GRIMA — Accueil">Michaël S. GRIMA</a>
        <button class="menu-toggle" type="button" aria-label="Ouvrir le menu" aria-expanded="false">
          <span></span><span></span>
        </button>
        <div class="nav-links" data-nav>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <div class="header-controls">
          <label class="theme-toggle">
            <input type="checkbox" data-theme-toggle />
            <span class="theme-toggle-track" aria-hidden="true"></span>
            <span class="theme-toggle-label">Blanc</span>
          </label>
        </div>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>

    <dialog id="project-dialog" class="project-dialog">
      <button type="button" class="dialog-close" data-dialog-close aria-label="Fermer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <figure class="dialog-media">
        <img data-dialog-image alt="" width="900" height="560" />
        <span class="media-tag" data-dialog-category></span>
        <span class="lock-badge" data-dialog-lock hidden>Privé</span>
      </figure>
      <div class="dialog-body">
        <div class="project-meta">
          <span class="status-dot">Étude de cas</span>
          <span data-dialog-stack0></span>
        </div>
        <h3 data-dialog-title></h3>
        <p data-dialog-summary></p>
        <p class="impact" data-dialog-impact></p>
        <div class="stack-list" data-dialog-stack-list aria-label="Technologies"></div>
        <div class="project-actions" data-dialog-actions></div>
      </div>
    </dialog>

    <script is:inline src={withBase('/data-bg.js')} defer></script>
    <script is:inline src={withBase('/site.js')} defer></script>
  </body>
</html>
