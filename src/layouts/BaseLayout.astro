---
import '../styles/global.css';
import { withBase } from '../lib/paths';

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://grimael.github.io');
// Vite's dev server injects component/global CSS via inline <style> tags for HMR;
// the production build emits real <link rel="stylesheet"> files, so 'unsafe-inline'
// is only needed for style-src while running `astro dev`, never in the deployed site.
const styleSrc = import.meta.env.DEV
  ? "'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com"
  : "'self' https://fonts.googleapis.com https://api.fontshare.com";
const nav = [
  { href: withBase('/'), label: 'Accueil', labelEn: 'Home' },
  { href: withBase('/about/'), label: 'À propos', labelEn: 'About' },
  { href: withBase('/projects/'), label: 'Projets', labelEn: 'Projects' },
  { href: withBase('/contact/'), label: 'Contact', labelEn: 'Contact' }
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      http-equiv="Content-Security-Policy"
      content={`default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; img-src 'self' data: https://cdn.jsdelivr.net https://cdn.simpleicons.org https://api.iconify.design https://avatars.githubusercontent.com https://commons.wikimedia.org; style-src ${styleSrc}; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com; script-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; form-action 'self' mailto:; upgrade-insecure-requests;`}
    />
    <meta http-equiv="Permissions-Policy" content="accelerometer=(), autoplay=(), camera=(), clipboard-read=(), clipboard-write=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index,follow" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=satoshi@400,500,700,900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,600;1,400&family=Instrument+Serif:ital@1&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script src={withBase('/pref-init.js')}></script>
  </head>
  <body>
    <canvas id="data-bg" aria-hidden="true"></canvas>
    <a class="skip-link" href="#content" data-fr="Aller au contenu" data-en="Skip to content">Aller au contenu</a>
    <header class="site-header">
      <nav class="nav-shell" aria-label="Navigation principale" data-fr-aria="Navigation principale" data-en-aria="Main navigation">
        <a class="signature" href={withBase('/')} aria-label="Michaël GRIMA — Accueil" data-fr-aria="Michaël GRIMA — Accueil" data-en-aria="Michaël GRIMA — Home">Michaël GRIMA</a>
        <button class="menu-toggle" type="button" aria-label="Ouvrir le menu" data-fr-aria="Ouvrir le menu" data-en-aria="Open menu" aria-expanded="false">
          <span></span><span></span>
        </button>
        <div class="nav-links" data-nav>
          {nav.map((item) => <a href={item.href} data-fr={item.label} data-en={item.labelEn}>{item.label}</a>)}
        </div>
        <div class="header-controls">
          <div class="lang-toggle" role="group" aria-label="Langue du site">
            <button type="button" data-lang-btn="fr" aria-pressed="true">FR</button>
            <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
          </div>
          <label class="theme-toggle">
            <input type="checkbox" data-theme-toggle />
            <span class="theme-toggle-track" aria-hidden="true"></span>
            <span class="theme-toggle-label" data-fr="Blanc" data-en="White">Blanc</span>
          </label>
        </div>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer"></footer>

    <dialog id="project-dialog" class="project-dialog">
      <button type="button" class="dialog-close" data-dialog-close aria-label="Fermer" data-fr-aria="Fermer" data-en-aria="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <figure class="dialog-media">
        <img data-dialog-image alt="" width="900" height="560" />
        <span class="media-tag" data-dialog-category></span>
        <span class="lock-badge" data-dialog-lock hidden data-fr="Privé" data-en="Private">Privé</span>
      </figure>
      <div class="dialog-body">
        <div class="project-meta">
          <span class="status-dot" data-fr="Étude de cas" data-en="Case study">Étude de cas</span>
          <span data-dialog-stack0></span>
        </div>
        <h3 data-dialog-title></h3>
        <p data-dialog-summary></p>
        <p class="impact" data-dialog-impact></p>
        <div class="stack-list" data-dialog-stack-list aria-label="Technologies"></div>
        <div class="project-actions" data-dialog-actions></div>
      </div>
    </dialog>

    <script src={withBase('/data-bg.js')} defer></script>
    <script src={withBase('/site.js')} defer></script>
  </body>
</html>
